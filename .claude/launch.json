{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "eva-dev",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "port": 5173,
            "url": "http://eva.test"
        },
        {
            "name": "eva-serve",
            "runtimeExecutable": "php",
            "runtimeArgs": [
                "artisan",
                "serve",
                "--host=127.0.0.1",
                "--port=8000"
            ],
            "port": 8000,
            "url": "http://127.0.0.1:8000"
        }
    ]
}
